<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECHFIX / ADMIN PORTAL"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Manage Technicians"
            android:textColor="@color/tech_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="View technicians and manage their profiles."
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtTechnicianFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Existing User as Technician"
                android:textColor="@color/tech_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editTechnicianEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Registered user email"
                android:inputType="textEmailAddress"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/editTechnicianName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Technician name"
                android:inputType="textPersonName"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/editTechnicianPhone"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Phone number"
                android:inputType="phone"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />


            <EditText
                android:id="@+id/editTechnicianBranch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Branch (e.g. Colombo 07)"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />


            <Button
                android:id="@+id/btnSaveTechnician"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Assign Technician Role"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelTechnicianEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/tech_surface_light"
                android:text="Cancel Editing"
                android:textAllCaps="false"
                android:textColor="@color/tech_text"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtTechnicianCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Technicians"
            android:textColor="@color/tech_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshTechnicians"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/tech_surface_light"
            android:text="Refresh Technicians"
            android:textAllCaps="false"
            android:textColor="@color/tech_text" />

        <ProgressBar
            android:id="@+id/techniciansProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/tech_teal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoTechnicians"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:padding="18dp"
            android:text="No technicians found."
            android:textColor="@color/tech_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/techniciansContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
