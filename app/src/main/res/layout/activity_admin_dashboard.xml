<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TECHFIX  /  ADMIN PORTAL"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Welcome back!"
            android:textColor="@color/tech_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Here's what's happening at TechFix."
            android:textColor="@color/tech_text_secondary"
            android:textSize="15sp" />


        <!-- STATISTICS CARDS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tech_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL REPAIRS"
                    android:textColor="@color/tech_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtTotalRepairs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="—"
                    android:textColor="@color/tech_text"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="All appointments"
                    android:textColor="@color/tech_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="135dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tech_card"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    android:textColor="@color/tech_warning"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtPendingRepairs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="—"
                    android:textColor="@color/tech_text"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Awaiting action"
                    android:textColor="@color/tech_text_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- MANAGEMENT SECTION -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Management"
            android:textColor="@color/tech_text"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- APPOINTMENTS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Repair Appointments"
                android:textColor="@color/tech_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Review bookings, assign technicians and update repair status."
                android:textColor="@color/tech_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManageAppointments"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Manage Appointments  →"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SERVICES CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Services &amp; Pricing"
                android:textColor="@color/tech_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manage repair services and service prices."
                android:textColor="@color/tech_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManageServices"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Manage Services  →"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- TECHNICIANS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Technician Management"
                android:textColor="@color/tech_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Manage technician profiles and assignments."
                android:textColor="@color/tech_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManageTechnicians"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Manage Technicians  →"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- SPARE PARTS CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spare Parts Inventory"
                android:textColor="@color/tech_text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Monitor spare parts and stock availability."
                android:textColor="@color/tech_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnManageParts"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Manage Spare Parts  →"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- LOGOUT -->

        <Button
            android:id="@+id/btnAdminLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="@color/tech_surface_light"
            android:text="Log Out"
            android:textAllCaps="false"
            android:textColor="@color/tech_text"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="TECHFIX  •  ADMIN PORTAL"
            android:textColor="@color/tech_text_secondary"
            android:textSize="11sp" />

    </LinearLayout>

</ScrollView>