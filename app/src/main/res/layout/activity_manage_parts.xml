<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECHFIX / ADMIN PORTAL"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Manage Spare Parts"
            android:textColor="@color/tech_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Manage inventory, prices and stock availability."
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <!-- ADD / EDIT FORM -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tech_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtPartFormTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add New Part"
                android:textColor="@color/tech_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editPartName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Part name (e.g. Phone battery)"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/editPartDevice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Compatible device / model"
                android:inputType="textCapSentences"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />

            <EditText
                android:id="@+id/editPartPrice"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Unit price (LKR)"
                android:inputType="numberDecimal"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />


            <EditText
                android:id="@+id/editPartBranch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Branch (Colombo or Galle)"
                android:inputType="textCapWords"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />


            <EditText
                android:id="@+id/editPartQuantity"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_tech_input"
                android:hint="Stock quantity"
                android:inputType="number"
                android:padding="12dp"
                android:singleLine="true"
                android:textColor="@color/tech_text"
                android:textColorHint="@color/tech_text_secondary" />

            <Button
                android:id="@+id/btnSavePart"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/tech_teal"
                android:text="Add Part"
                android:textAllCaps="false"
                android:textColor="@color/tech_background"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelPartEdit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/tech_surface_light"
                android:text="Cancel Editing"
                android:textAllCaps="false"
                android:textColor="@color/tech_text"
                android:visibility="gone" />

        </LinearLayout>

        <!-- INVENTORY -->

        <TextView
            android:id="@+id/txtPartCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Spare Parts Inventory"
            android:textColor="@color/tech_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshParts"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/tech_surface_light"
            android:text="Refresh Inventory"
            android:textAllCaps="false"
            android:textColor="@color/tech_text" />

        <ProgressBar
            android:id="@+id/partsProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:indeterminateTint="@color/tech_teal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoParts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:padding="18dp"
            android:text="No spare parts added yet."
            android:textColor="@color/tech_text_secondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/partsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
