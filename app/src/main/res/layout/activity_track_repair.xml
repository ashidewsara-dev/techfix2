<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECHFIX / REPAIR TRACKING"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Track Your Repair"
            android:textColor="@color/tech_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Check the latest status of your submitted repair appointments."
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <!-- REFRESH BUTTON -->

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/tech_teal"
            android:text="Refresh Repair Status"
            android:textAllCaps="false"
            android:textColor="@color/tech_background"
            android:textStyle="bold" />

        <!-- LOADING INDICATOR -->

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/tech_teal"
            android:visibility="gone" />

        <!-- EMPTY / ERROR MESSAGE -->

        <TextView
            android:id="@+id/txtNoRepairs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_tech_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="No repair appointments found."
            android:textColor="@color/tech_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- REPAIR CARDS ARE ADDED HERE FROM JAVA -->

        <LinearLayout
            android:id="@+id/repairContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
