<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECHFIX / REPAIR HISTORY"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Repair History"
            android:textColor="@color/tech_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your completed device repairs, all in one place."
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <!-- COMPLETED REPAIR COUNT -->

        <TextView
            android:id="@+id/txtCompletedCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tech_card"
            android:padding="18dp"
            android:text="Loading completed repairs..."
            android:textColor="@color/tech_teal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- REFRESH BUTTON -->

        <Button
            android:id="@+id/btnRefreshHistory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/tech_teal"
            android:text="Refresh History"
            android:textAllCaps="false"
            android:textColor="@color/tech_background"
            android:textStyle="bold" />

        <!-- LOADING INDICATOR -->

        <ProgressBar
            android:id="@+id/historyProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:indeterminateTint="@color/tech_teal"
            android:visibility="gone" />

        <!-- EMPTY / ERROR MESSAGE -->

        <TextView
            android:id="@+id/txtNoHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_tech_card"
            android:gravity="center"
            android:padding="24dp"
            android:text="No completed repairs yet."
            android:textColor="@color/tech_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- COMPLETED REPAIR CARDS -->

        <LinearLayout
            android:id="@+id/historyContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
