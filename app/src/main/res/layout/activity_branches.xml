<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tech_background"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TECHFIX / BRANCH LOCATOR"
        android:textColor="@color/tech_teal"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Find a Branch"
        android:textColor="@color/tech_text"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtNearestBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Explore our Colombo and Galle branches on the map."
        android:textColor="@color/tech_text_secondary"
        android:textSize="14sp" />

    <org.osmdroid.views.MapView
        android:id="@+id/branchMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@color/tech_surface" />

    <Button
        android:id="@+id/btnFindNearest"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/tech_teal"
        android:text="Find My Nearest Branch"
        android:textAllCaps="false"
        android:textColor="@color/tech_background"
        android:textStyle="bold" />

</LinearLayout>
