<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tech_background"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TECHFIX / OUR SERVICES"
            android:textColor="@color/tech_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Repair Services"
            android:textColor="@color/tech_text"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Explore our available device repair services."
            android:textColor="@color/tech_text_secondary"
            android:textSize="14sp" />

        <!-- SERVICE COUNT -->

        <TextView
            android:id="@+id/txtServiceCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_tech_card"
            android:padding="18dp"
            android:text="Loading services..."
            android:textColor="@color/tech_teal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- REFRESH BUTTON -->

        <Button
            android:id="@+id/btnRefreshCustomerServices"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@color/tech_surface_light"
            android:text="Refresh Services"
            android:textAllCaps="false"
            android:textColor="@color/tech_text" />

        <!-- LOADING INDICATOR -->

        <ProgressBar
            android:id="@+id/servicesProgressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:indeterminateTint="@color/tech_teal"
            android:visibility="gone" />

        <!-- EMPTY / ERROR MESSAGE -->

        <TextView
            android:id="@+id/txtNoServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_tech_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="No repair services are available yet."
            android:textColor="@color/tech_text_secondary"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- SERVICES LIST -->

        <LinearLayout
            android:id="@+id/servicesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical" />

        <!-- PRICE NOTE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Prices shown are starting prices. The final cost may vary depending on your device and the required repair."
            android:textColor="@color/tech_text_secondary"
            android:textSize="12sp" />

        <!-- BOOK REPAIR BUTTON -->

        <Button
            android:id="@+id/btnBookFromServices"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:backgroundTint="@color/tech_teal"
            android:text="Book a Repair"
            android:textAllCaps="false"
            android:textColor="@color/tech_background"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
